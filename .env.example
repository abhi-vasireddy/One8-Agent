# CampusFlow AI — Root Environment Variables Template
# Copy this file to .env and provide your deployment credentials.

PORT=3001
NODE_ENV=development

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Database Connection
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# JWT Secret
JWT_SECRET=your-supabase-jwt-secret

# Google Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# Super Admin Initial Bootstrap Credentials
CAMPUSFLOW_TEMP_ADMIN_EMAIL=admin@campusflow.local
CAMPUSFLOW_TEMP_ADMIN_PASSWORD=your-secure-admin-password
CAMPUSFLOW_ENABLE_DEMO_AUTH=false
