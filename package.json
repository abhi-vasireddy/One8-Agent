{
  "name": "campusflow-ai",
  "version": "1.0.0",
  "private": true,
  "description": "CampusFlow AI — Configurable, metadata-driven college administration platform",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "cd client && npm run dev",
    "dev:server": "cd server && npm run dev",
    "install:all": "cd client && npm install && cd ../server && npm install",
    "build": "cd client && npm run build",
    "test": "cd server && npm test",
    "db:migrate": "cd server && npm run db:migrate",
    "db:seed": "cd server && npm run db:seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "dependencies": {
    "@supabase/server": "^1.9.1"
  }
}
