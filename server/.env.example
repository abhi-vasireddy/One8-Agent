# Server Environment Variables
# Copy to .env and fill in values

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Database (Direct connection for Drizzle)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# JWT (uses Supabase JWT secret)
JWT_SECRET=your-supabase-jwt-secret

# Server
PORT=3001
NODE_ENV=development

# AI
GEMINI_API_KEY=your-gemini-api-key

# Temporary Development Super Admin Bootstrap Credentials
# (Set in server .env only — NEVER commit passwords or expose to frontend)
CAMPUSFLOW_TEMP_ADMIN_EMAIL=
CAMPUSFLOW_TEMP_ADMIN_PASSWORD=
CAMPUSFLOW_ENABLE_DEMO_AUTH=false
